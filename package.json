{
  "name": "dsh-auto-create-folder",
  "version": "1.1.1",
  "description": "Auto-create a per-task folder in the workspace before creating new files, and redirect creations into it.",
  "type": "module",
  "main": "lib/auto-folder.js",
  "exports": {
    ".": "./lib/auto-folder.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/auto-folder.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
